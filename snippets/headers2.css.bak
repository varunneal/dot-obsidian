/* Custom variable for decorative elements */
.theme-light, .theme-dark {
    --header-decoration-color: var(--text-muted);
}


/* Add line under H1 using pseudo-element */
.markdown-source-view .cm-line:has(.cm-header-1)::after {
    content: "";
    display: block;
    height: 3px;
    background: var(--header-decoration-color);
    margin-top: 0.3em;
    margin-bottom: 0.5em;
    width: 100%;
}

/* Add shorter line under H2 using pseudo-element */
.markdown-source-view .cm-line:has(.cm-header-2)::after {
    content: "";
    display: block;
    height: 2px;
    background: var(--header-decoration-color);
    margin-top: 0.3em;
    margin-bottom: 0.5em;
    width: 75%;
}


/* H3 line */
.markdown-source-view .cm-line:has(.cm-header-3) {
    padding-left: 0.8em;
    border-left: 3px solid var(--header-decoration-color);
    padding-top: 0em;
    margin-top: 0.2em;
}


/* H4 dot */
.markdown-source-view .cm-line:has(.cm-header-4) {
    padding-left: 1em;
    position: relative;
}

.markdown-source-view .cm-line:has(.cm-header-4)::before {
    content: "||";
    color: var(--header-decoration-color);
    position: absolute;
    left: 0;
}

/* Styles for H5 headers in editor */
.markdown-source-view .cm-header.cm-header-5 {
    font-style: italic;
}

/* Styles for H6 headers in editor */
.markdown-source-view .cm-header.cm-header-6 {
    text-transform: uppercase;
    letter-spacing: 1px;
}

/* Ensure header markers (#) are visible but subtle */
.markdown-source-view .cm-formatting-header {
    opacity: 0.7;
}
